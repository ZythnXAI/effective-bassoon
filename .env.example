# =============================================================================
# NexusMind AI - Configuração de Ambiente
# =============================================================================

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./nexusmind.db

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# =============================================================================
# AI API KEYS - OBRIGATÓRIO PARA FUNCIONAMENTO
# =============================================================================

# E2B API (Código e Chat)
E2B_API_KEY=your-e2b-api-key-here

# Exa AI (Busca Semântica)
EXA_AI_API_KEY=your-exa-ai-api-key-here

# Manus AI
MANUS_AI_API_KEY=your-manus-ai-api-key-here

# GROQ API (Modelos Rápidos)
GROQ_API_KEY=your-groq-api-key-here

# Fal AI
FAL_AI_API_KEY=your-fal-ai-api-key-here

# Daytona (Execução de Código)
DAYTONA_API_KEY=your-daytona-api-key-here

# BrowserBase (Navegação Web)
BROWSERBASE_API_KEY=your-browserbase-api-key-here

# NVIDIA NIM
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key-here

# =============================================================================
# AI API ENDPOINTS
# =============================================================================

# E2B
E2B_BASE_URL=https://api.e2b.dev

# Exa AI
EXA_AI_BASE_URL=https://api.exa.ai

# Manus AI
MANUS_AI_BASE_URL=https://api.manus.ai

# GROQ
GROQ_BASE_URL=https://api.groq.com/v1

# Fal AI
FAL_AI_BASE_URL=https://fal.run

# Daytona
DAYTONA_BASE_URL=https://api.daytona.io

# BrowserBase
BROWSERBASE_BASE_URL=https://api.browserbase.io

# NVIDIA NIM
NVIDIA_NIM_BASE_URL=https://api.nim.nvidia.com

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=NexusMind AI
VITE_APP_VERSION=1.0.0

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
